{
  "name": "tdai-pet",
  "version": "0.2.0",
  "description": "TD AI Memory Pet — 桌面记忆守护",
  "main": "src/main.js",
  "author": "huihui",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tdai.pet",
    "productName": "TD记忆守护",
    "directories": { "output": "../release", "buildResources": "../build" },
    "electronLanguages": ["zh-CN", "en-US"],
    "publish": [
      {
        "provider": "github",
        "owner": "HUIdada1",
        "repo": "tencentdb-memory-mcp",
        "releaseType": "release"
      }
    ],
    "files": [
      "src",
      "core",
      "mcp"
    ],
    "extraResources": [
      { "from": "../build/icon.png", "to": "build/icon.png" },
      { "from": "../build/tray.png", "to": "build/tray.png" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "../build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TD记忆守护",
      "artifactName": "TDMemoryPet-Setup-${version}.exe"
    },
    "portable": { "artifactName": "TDMemoryPet-${version}-portable.exe" },
    "compression": "maximum"
  }
}
